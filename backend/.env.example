# Copy to .env for local development. Never commit .env.

APP_ENVIRONMENT=local
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# SQLite locally; a postgresql+psycopg:// URL in staging/production.
APP_DATABASE_URL=sqlite:///./acme_pay_insights.db

APP_DEFAULT_REPORTING_CURRENCY=USD
APP_CORS_ORIGINS=["http://localhost:5173"]
